# ==============================================================================
# CRMaster — Estúdio Henrique Matos (Belo Horizonte) — Fase 1 + Fase 2
# Copie este arquivo para .env.local e preencha com suas chaves reais.
# Enquanto estiver vazio, o sistema funciona 100% em modo local (JSON + localStorage)
# com geração de PDF e Pix BR Code 100% locais (sem APIs pagas externas).
# ==============================================================================

# 1. Banco de Dados Persistente — Firebase Firestore (Recomendado)
# Copie os valores do Firebase Console -> Configurações do Projeto -> Seus apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 1b. Banco de Dados Alternativo — Supabase (Opcional)
# Crie um projeto em https://supabase.com e execute o arquivo supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Captação de Leads BH — Google Places API (fallback gratuito OpenStreetMap BH)
GOOGLE_PLACES_API_KEY=

# 3. Disparo de E-mails Transacionais & Radar — Resend API
RESEND_API_KEY=
RESEND_FROM_EMAIL=Henrique Matos Studio <onboarding@resend.dev>
ADMIN_EMAIL=henrickschecter@gmail.com

# 4. WhatsApp Comercial do Estúdio (somente dígitos com DDI + DDD)
NEXT_PUBLIC_WHATSAPP_NUMBER=5531998427100

# 5. Disparo Automático de WhatsApp — Evolution API / Z-API (Fase 2)
# Deixe vazio para manter o Modo Seguro (1-Clique via wa.me) como padrão
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=

# 6. Segurança do Motor de Follow-up Automático (Vercel Cron)
CRON_SECRET=troque-por-um-segredo-forte

# 7. Pix Copia e Cola Estático (Padrão BR Code / EMV) — Chave Pix do Estúdio
# Pode ser e-mail, CPF/CNPJ, telefone (+5531...) ou chave aleatória
NEXT_PUBLIC_PIX_KEY=henrickschecter@gmail.com

# 8. URL pública da aplicação (usada na geração dos links rastreáveis /proposta/[leadId])
NEXT_PUBLIC_APP_URL=http://localhost:3000

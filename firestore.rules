rules_version = '2';

// Regras de acesso do Cloud Firestore para as coleções do CRMaster
// Cole no Firebase Console -> Firestore Database -> Regras (Rules)
service cloud.firestore {
  match /databases/{database}/documents {
    match /crm_settings/{docId} {
      allow read, write: if true;
    }
    match /crm_partners/{docId} {
      allow read, write: if true;
    }
    match /crm_leads/{docId} {
      allow read, write: if true;
    }
    match /crm_templates/{docId} {
      allow read, write: if true;
    }
  }
}
